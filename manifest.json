{
  "manifest_version": 3,
  "name": "Social Image Downloader (FB/IG)",
  "version": "1.3.1",
  "description": "Beautiful gallery + Live Capture Mode for FB/IG images (JPG/PNG/WEBP, skip <300x300).",
  "permissions": ["downloads", "tabs", "scripting", "activeTab", "storage"],
  "host_permissions": ["https://*.facebook.com/*", "https://*.instagram.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Social Image Downloader"
  },
  "background": {
    "service_worker": "background.js"
  }
}
