{
  "manifest_version": 3,
  "name": "Social Image Downloader (FB/IG)",
  "version": "1.0.0",
  "description": "Preview and download JPG/PNG/WEBP images from Facebook/Instagram. Skips small images.",
  "permissions": ["downloads", "tabs", "scripting", "activeTab"],
  "host_permissions": ["https://*.facebook.com/*", "https://*.instagram.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Download images"
  },
  "background": {
    "service_worker": "background.js"
  }
}
